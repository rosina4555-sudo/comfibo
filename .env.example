# Supabase — Project Settings > API
# Copy this file to .env, fill in, then restart the dev server.
#
#   VITE_SUPABASE_URL     -> "Project URL"   (https://xyz.supabase.co)
#                             The REST URL (https://xyz.supabase.co/rest/v1/) also works.
#   VITE_SUPABASE_ANON_KEY-> "anon public" key (NOT the service_role key)
#
# Schema: run supabase-schema.sql in the SQL Editor first.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
